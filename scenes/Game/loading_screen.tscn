[gd_scene format=3 uid="uid://org1g44dt6fy"]

[ext_resource type="VideoStream" uid="uid://cpjyb0gpfjgv" path="res://assets/sprites/SkirmishChapterImages/LoadingScreen/loading_screen.ogv" id="1_w4mdj"]

[sub_resource type="GDScript" id="GDScript_w4mdj"]
script/source = "extends Control

const MIN_SHOW_SEC := 3.0

@onready var video: VideoStreamPlayer = $VideoStreamPlayer
@onready var bar: ProgressBar = $ProgressBar

var target := \"\"
var shown := 0.0
var elapsed := 0.0
var done := false

func _ready():
	bar.min_value = 0
	bar.max_value = 100
	bar.value = 0
	video.finished.connect(video.play)
	video.play()

	target = SceneLoader.next_scene
	if target == \"\":
		push_warning(\"No scene to load\")
		get_tree().change_scene_to_file(\"res://scenes/StartingMenu/selection_menu.tscn\")
		return
	ResourceLoader.load_threaded_request(target)

func _process(delta):
	if target == \"\" or done:
		return
	elapsed += delta

	var progress := []
	var status = ResourceLoader.load_threaded_get_status(target, progress)

	if status == ResourceLoader.THREAD_LOAD_FAILED or status == ResourceLoader.THREAD_LOAD_INVALID_RESOURCE:
		push_error(\"Failed to load \" + target)
		done = true
		get_tree().change_scene_to_file(\"res://scenes/StartingMenu/selection_menu.tscn\")
		return

	var real: float = 100.0 if status == ResourceLoader.THREAD_LOAD_LOADED else progress[0] * 100.0
	shown = move_toward(shown, real, (100.0 / MIN_SHOW_SEC) * delta)
	bar.value = shown

	if status == ResourceLoader.THREAD_LOAD_LOADED and shown >= 100.0 and elapsed >= MIN_SHOW_SEC:
		done = true
		var packed = ResourceLoader.load_threaded_get(target)
		get_tree().change_scene_to_packed(packed)
"

